# Emergency Response Bot AI - Environment Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=paste-your-jwt-secret-here
VITE_API_URL=/api
VITE_WS_URL=ws://localhost:3000/ws

# Google Gemini (server only — the single AI provider, never a VITE_
# variable, never commit a real key). Paste the real key in Vercel
# Settings -> Environment Variables, or in a local .env file at this repo
# root (which is gitignored and never committed).
# Default model is a currently supported Flash model; override it here
# or in Vercel only if Gemini reports that model as unavailable.
GEMINI_API_KEY=paste-your-gemini-key-here
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter (server only — used first when its key is set, otherwise
# Gemini is used; never a VITE_ variable, never commit a real key).
# Paste the real key in Vercel Settings -> Environment Variables, or in a
# local .env file at this repo root (which is gitignored and never committed).
# Default model verified against the live OpenRouter models list on
# 2026-11-04; free models rotate, so override it here or in Vercel if
# OpenRouter reports that model as unavailable.
OPENROUTER_API_KEY=paste-your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
