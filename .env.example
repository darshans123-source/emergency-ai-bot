# Emergency Response Bot AI - Environment Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=emergency-response-bot-jwt-secret-key-2026
OPENAI_API_KEY=
GEMINI_API_KEY=
VITE_API_URL=/api
VITE_WS_URL=ws://localhost:3000/ws

# Free.ai (server only — never a VITE_ variable, never commit a real key)
# Paste the real key in Vercel Settings -> Environment Variables, or in a
# local .env file at this repo root (which is gitignored and never committed).
FREE_AI_API_KEY=paste-your-free-ai-key-here
FREE_AI_API_URL=https://api.free.ai
FREE_AI_MODEL=qwen7b
