# Emergency Response Bot AI - Environment Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=paste-your-jwt-secret-here
VITE_API_URL=/api
VITE_WS_URL=ws://localhost:3000/ws

# Google Gemini (server only — the single AI provider, never a VITE_
# variable, never commit a real key). Paste the real key in Vercel
# Settings -> Environment Variables, or in a local .env file at this repo
# root (which is gitignored and never committed).
# Default model is a currently supported Flash model; override it here
# or in Vercel only if Gemini reports that model as unavailable.
GEMINI_API_KEY=paste-your-gemini-key-here
GEMINI_MODEL=gemini-3.8-flash
