# Emergency Response Bot AI Configuration
ENVIRONMENT=development
PORT=3000
DATABASE_URL=sqlite:///./data/emergency_bot.db
JWT_SECRET=super-secret-jwt-key-for-emergency-bot-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional External AI Service (Rule-based engine will be used if omitted)
GEMINI_API_KEY=

# Routing & Map Tile Settings
MAP_TILE_PROVIDER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
ENABLE_REAL_TIME_DISPATCH_RESTRICTION=true
DEMO_MODE=true
